<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
	  pom-scijava 43.0.0, the same parent as Object Territories 0.3.0. Keep
	  the two equal: resolving a different net.imagej:ij build here than the
	  plugin resolves would put a second ImageJ on the test classpath and make
	  the plugin's bit-identical golden gate meaningless. Raise this only
	  together with the plugin.
	-->
	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>43.0.0</version>
		<relativePath/>
	</parent>

	<groupId>io.github.jay2owe</groupId>
	<artifactId>territories-core</artifactId>
	<version>0.2.2</version>

	<name>territories-core</name>
	<description>Bounded Voronoi territory, neighbourhood-interaction and kernel-density engine, as an embeddable module. Never shipped as a jar.</description>
	<url>https://github.com/Jay2owe/ObjectTerritories</url>
	<inceptionYear>2026</inceptionYear>

	<organization>
		<name>UK Dementia Research Institute at Imperial College London</name>
		<url>https://ukdri.ac.uk/centres/imperial</url>
	</organization>
	<licenses>
		<license>
			<name>BSD 3-Clause License</name>
			<url>https://opensource.org/licenses/BSD-3-Clause</url>
			<distribution>repo</distribution>
		</license>
	</licenses>
	<developers>
		<developer>
			<id>Jay2owe</id>
			<name>Jamie Malcolm</name>
			<email>jamiemalcolm12@gmail.com</email>
			<url>https://github.com/Jay2owe</url>
			<organization>UK Dementia Research Institute at Imperial College London</organization>
			<organizationUrl>https://www.ukdri.ac.uk/labs/brancaccio-lab</organizationUrl>
			<properties>
				<orcid>0009-0008-3862-2776</orcid>
			</properties>
			<roles>
				<role>founder</role>
				<role>lead</role>
				<role>developer</role>
				<role>maintainer</role>
			</roles>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>Jamie Malcolm</name>
			<url>https://github.com/Jay2owe</url>
			<properties><id>Jay2owe</id></properties>
		</contributor>
	</contributors>
	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/tag/imagej</archive>
		</mailingList>
	</mailingLists>

	<scm>
		<connection>scm:git:https://github.com/Jay2owe/ObjectTerritories</connection>
		<developerConnection>scm:git:git@github.com:Jay2owe/ObjectTerritories</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/Jay2owe/ObjectTerritories</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/Jay2owe/ObjectTerritories/issues</url>
	</issueManagement>
	<ciManagement>
		<system>None</system>
	</ciManagement>

	<properties>
		<package-name>sc.fiji.territories.core</package-name>
		<license.licenseName>bsd_3</license.licenseName>
		<license.copyrightOwners>Jamie Malcolm</license.copyrightOwners>
		<maven.compiler.release>8</maven.compiler.release>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<jts.version>1.19.0</jts.version>
		<!-- No main class: this module is a library, never a plugin. -->
		<enforcer.skip>true</enforcer.skip>
	</properties>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!--
		  The host. `provided`, because Fiji already is ImageJ; bundling it
		  into a consumer would be the classic duplicate-classloader bug.
		-->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>ij</artifactId>
			<scope>provided</scope>
		</dependency>

		<!--
		  A genuine engine dependency, not chassis plumbing: the 2D path is
		  exact Voronoi tessellation, Delaunay adjacency and polygon overlay,
		  which is what JTS is. `compile`, not `provided`, so a consumer
		  inherits it transitively and shades it alongside this module — a
		  bare Fiji has never heard of JTS.

		  EPL 2.0 / EDL 1.0 dual licence. EDL 1.0 is BSD-3 in substance, so a
		  BSD-3 consumer ships under BSD-3 with the JTS notice retained.
		  Nothing here links GPL. Version pinned, not inherited, so this
		  module and the plugin cannot resolve different JTS builds.
		-->
		<dependency>
			<groupId>org.locationtech.jts</groupId>
			<artifactId>jts-core</artifactId>
			<version>${jts.version}</version>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-jar-plugin</artifactId>
				<configuration>
					<archive>
						<manifest>
							<addClasspath>false</addClasspath>
						</manifest>
						<manifestEntries>
							<Automatic-Module-Name>io.github.jay2owe.territories.core</Automatic-Module-Name>
						</manifestEntries>
					</archive>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
